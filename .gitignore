# Runtime Session Telemetry & Logs (Keep .gitkeep)
logs/telemetry/*
!logs/telemetry/.gitkeep
logs/system/*
!logs/system/.gitkeep

# Generated Reports & Figures (Keep .gitkeep)
reports/figures/*
!reports/figures/.gitkeep

# Local user profile instances (Keep template default_user.json and .gitkeep)
profiles/*
!profiles/.gitkeep
!profiles/default_user.json

# Large media video recordings (Keep .gitkeep)
media/demo_recordings/*
!media/demo_recordings/.gitkeep

# LaTeX build intermediate artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/sections/*.aux

